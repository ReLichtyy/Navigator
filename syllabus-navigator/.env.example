APP_NAME=Syllabus Navigator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

POSTGRES_USER=syllabus
POSTGRES_PASSWORD=syllabus
POSTGRES_DB=syllabus_navigator
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CHROMA_HOST=chroma
# Inside Docker network, Chroma listens on container port 8000 (host maps 8001:8000).
CHROMA_PORT=8000

FRONTEND_PORT=3000

# Comma-separated list of allowed CORS origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser client calls API (use localhost when ports are published to the host).
NEXT_PUBLIC_API_URL=http://localhost:8000
