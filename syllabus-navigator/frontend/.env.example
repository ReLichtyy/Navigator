# URL base para conectar el Frontend a la API del Backend (FastAPI)
# Para producción (ej. Railway):
NEXT_PUBLIC_API_URL=https://syllabus-backend-production.up.railway.app

# ─────────────────────────────────────────────────────────────────────────────
# Neon Postgres — conexión server-side ÚNICAMENTE
# ⚠️  NUNCA uses el prefijo NEXT_PUBLIC_; expone credenciales al navegador.
# En desarrollo: copia este archivo a .env.local y rellena el valor.
# En Vercel: ve a Settings → Environment Variables y añade DATABASE_URL.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
