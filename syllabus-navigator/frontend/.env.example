# ─── App Info ────────────────────────────────────────────────────────
APP_NAME="Syllabus Navigator"
APP_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────
# Generate a secret: npx auth secret (or `openssl rand -hex 32`)
AUTH_SECRET=d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (Sign in with Google) ──────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorized redirect URI MUST be:
#   {NEXTAUTH_URL}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google  (and the Vercel URL in prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database (Neon Postgres) ────────────────────────────────────────
# Pooler connection (used by API routes at runtime)
DATABASE_URL='postgresql://...'
# Direct connection (used by scripts/migrate.mjs for schema changes)
DATABASE_URL_DIRECT='postgresql://...'

# ─── LLM Providers ───────────────────────────────────────────────────
# Required: OpenAI API Key (default provider)
OPENAI_API_KEY=sk-proj-...

# Optional: OpenRouter API Key (fallback/extended models)
OPENROUTER_API_KEY=

# ─── App Config ──────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# ─── Cache (Optional) ────────────────────────────────────────────────
# If omitted, uses in-memory L1 cache (clears on serverless cold starts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron + Worker (Required in any deployed env) ────────────────────
# Secret guarding the scheduled jobs AND the fire-and-forget worker trigger
# (/api/cron/cleanup + /api/cron/process). Both endpoints FAIL CLOSED (500) if
# unset, and the upload worker can't self-trigger without it. Vercel injects this
# as `Authorization: Bearer <CRON_SECRET>` on scheduled cron invocations.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Blob Storage (Optional — persists account PDFs) ─────────────────
# Vercel Blob token. Without it, account uploads still work but the original PDF
# is NOT stored (degrades with a warning); guest uploads never store the PDF.
# Created automatically when you add a Blob store in Vercel (Storage → Blob).
BLOB_READ_WRITE_TOKEN=
