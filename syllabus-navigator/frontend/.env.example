# ─── App Info ────────────────────────────────────────────────────────
APP_NAME="Syllabus Navigator"
APP_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────
# Generate a secret: npx auth secret (or `openssl rand -hex 32`)
AUTH_SECRET=d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1d3b2b8c5e9a4f7c1
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (Sign in with Google) ──────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorized redirect URI MUST be:
#   {NEXTAUTH_URL}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google  (and the Vercel URL in prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database (Neon Postgres) ────────────────────────────────────────
# Pooler connection (host has `-pooler`) — used by API routes at runtime
DATABASE_URL='postgresql://...-pooler.<region>.aws.neon.tech/neondb?sslmode=require'
# Direct connection (host WITHOUT `-pooler`) — for migrations / long ops
DATABASE_URL_DIRECT='postgresql://....<region>.aws.neon.tech/neondb?sslmode=require'

# ─── LLM Providers ───────────────────────────────────────────────────
# Required: OpenAI API Key (default provider)
OPENAI_API_KEY=sk-proj-...

# Optional: OpenRouter API Key (fallback/extended models)
OPENROUTER_API_KEY=

# Required (chat + Study Engine verifier): direct DeepSeek provider.
DEEPSEEK_API_KEY=sk-...

# The Study Engine runs on direct OpenAI/DeepSeek (the Bluesmind gateway was
# removed 2026-07-01). Optional per-role model overrides — defaults in
# src/lib/llm/agent-models.ts:
# MODEL_INQUISITOR=gpt-5-mini
# MODEL_CASE=gpt-5-mini
# MODEL_VERIFIER=deepseek-chat
# MODEL_SYNTH=gpt-4o-mini
# MODEL_FLASHCARD=gpt-4o-mini
# MODEL_ROUTER=gpt-5-nano
# MODEL_RAG=gpt-5-mini   # graph/schedule/course-infer generators (OpenAI direct)
# MODEL_OCR=gpt-4o       # scanned PDF fallback; Responses API reads text + page images

# ─── App Config ──────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
# RAG relevance gate: max cosine distance for a chunk to count as relevant.
# Lower = stricter. Default 0.9 (tuned on real data). Off-topic questions past
# this get "no relevant context" instead of a hallucinated answer.
RAG_MAX_DISTANCE=0.9
# Feature flags (lib/config/flags.ts). DEFAULT_LLM_PROVIDER/MODEL above drive the
# default routing. VECTOR_BACKEND selects the vector store (only "pgvector" wired
# today). RAG_ENABLED=false turns off retrieval grounding (chat answers ungrounded).
VECTOR_BACKEND=pgvector
RAG_ENABLED=true
# Progressive durable pipeline rollout. Knowledge + graph are enabled by default;
# keep Study off until the cited-kit benchmark passes in the target environment.
KNOWLEDGE_PIPELINE_V2=true
GRAPH_PIPELINE_V2=true
STUDY_PIPELINE_V2=false

# ─── Cache (Optional) ────────────────────────────────────────────────
# If omitted, uses in-memory L1 cache (clears on serverless cold starts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron + Worker (Required in any deployed env) ────────────────────
# Secret guarding the scheduled jobs AND the fire-and-forget worker trigger
# (/api/cron/cleanup + /api/cron/process). Both endpoints FAIL CLOSED (500) if
# unset, and the upload worker can't self-trigger without it. Vercel injects this
# as `Authorization: Bearer <CRON_SECRET>` on scheduled cron invocations.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Blob Storage (Optional — persists account PDFs) ─────────────────
# Vercel Blob token. Without it, account uploads still work but the original PDF
# is NOT stored (degrades with a warning); guest uploads never store the PDF.
# Created automatically when you add a Blob store in Vercel (Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# ─── Notion product feedback (server-only; configure after UI/preconfiguration) ───
NOTION_ACCESS_TOKEN=
# Preferred when copied from Notion's "Manage data sources" menu.
NOTION_FEEDBACK_DATA_SOURCE_ID=
# Alternative: use the database ID from its URL. If the database has multiple
# data sources, also set the exact source name.
NOTION_FEEDBACK_DATABASE_ID=
NOTION_FEEDBACK_DATA_SOURCE_NAME=
